---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import RestaurantCard from '../components/RestaurantCard.astro';

const restaurants = await getCollection('restaurants');
const sorted = restaurants.sort((a, b) => b.data.rating - a.data.rating);

const cuisines = [...new Set(sorted.map(r => r.data.cuisine))].sort();
const suburbs  = [...new Set(sorted.map(r => r.data.suburb))].sort();
const prices   = ['$', '$$', '$$$', '$$$$'];
---

<Base title="Fork & Found — Melbourne Restaurant Reviews">

  <div class="page-header">
    <p class="eyebrow">Melbourne &bull; {sorted.length} Reviews</p>
    <h1>THE PLACE<br/><span>TO EAT</span></h1>
    <p class="subhead">No ads. No sponsored meals. Just honest food.</p>
  </div>

  <div class="filters">
    <div class="filter-group">
      <span class="filter-label">Cuisine</span>
      <div class="filter-pills">
        <button class="pill active" data-filter="cuisine" data-value="all">All</button>
        {cuisines.map(c => <button class="pill" data-filter="cuisine" data-value={c}>{c}</button>)}
      </div>
    </div>
    <div class="filter-group">
      <span class="filter-label">Location</span>
      <div class="filter-pills">
        <button class="pill active" data-filter="suburb" data-value="all">All</button>
        {suburbs.map(s => <button class="pill" data-filter="suburb" data-value={s}>{s}</button>)}
      </div>
    </div>
    <div class="filter-group">
      <span class="filter-label">Price</span>
      <div class="filter-pills">
        <button class="pill active" data-filter="price" data-value="all">All</button>
        {prices.map(p => <button class="pill" data-filter="price" data-value={p}>{p}</button>)}
      </div>
    </div>
  </div>

  <div class="sort-bar">
    <span id="results-count" class="results-count">{sorted.length} restaurants</span>
    <select id="sort-select" class="sort-select">
      <option value="rating">Sort: Rating</option>
      <option value="recent">Sort: Most Recent</option>
      <option value="name">Sort: A–Z</option>
    </select>
  </div>

  <div class="grid" id="grid">
    {sorted.map((r, i) => (
      <div
        class={`grid-item${i === 0 ? ' grid-item--featured' : ''}`}
        data-cuisine={r.data.cuisine}
        data-suburb={r.data.suburb}
        data-price={r.data.price}
        data-rating={r.data.rating}
        data-visited={r.data.visited.toISOString()}
        data-name={r.data.name}
      >
        <RestaurantCard
          name={r.data.name}
          suburb={r.data.suburb}
          cuisine={r.data.cuisine}
          rating={r.data.rating}
          price={r.data.price}
          highlight={r.data.highlight}
          tags={r.data.tags}
          slug={r.slug}
          would_return={r.data.would_return}
        />
      </div>
    ))}
  </div>

  <p class="empty-state" id="empty-state" style="display:none">No restaurants match those filters yet.</p>

</Base>

<style>
  /* Page header */
  .page-header {
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--border);
    padding-bottom: 1.5rem;
  }

  .eyebrow {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 0.5rem;
  }

  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8vw, 6rem);
    line-height: 0.95;
    letter-spacing: 0.04em;
    color: var(--ink);
    text-shadow: 3px 3px 0 rgba(46,111,64,0.15);
    margin-bottom: 0.75rem;
  }

  .page-header h1 span { color: var(--green); }

  .subhead {
    font-size: 0.88rem;
    color: var(--ink-soft);
    font-style: italic;
    font-family: var(--font-serif);
  }

  /* Filters */
  .filters {
    background: var(--white);
    border-radius: 15px;
    border: 1px solid var(--border);
    box-shadow: var(--card-shadow);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    min-width: 4.5rem;
  }

  .filter-pills { display: flex; gap: 0.35rem; flex-wrap: wrap; }

  .pill {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 0.25rem 0.7rem;
    font-size: 0.75rem;
    font-family: var(--font-body);
    font-weight: 500;
    cursor: pointer;
    color: var(--ink-mid);
    transition: all 0.15s;
  }

  .pill:hover { border-color: var(--green); color: var(--green); }
  .pill.active { background: var(--green); border-color: var(--green); color: #fff; }

  /* Sort bar */
  .sort-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .results-count {
    font-size: 0.8rem;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .sort-select {
    font-family: var(--font-body);
    font-size: 0.8rem;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.35rem 0.7rem;
    color: var(--ink);
    cursor: pointer;
  }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .grid-item--featured {
    grid-column: 1 / -1;
  }

  .grid-item--featured .card {
    flex-direction: row;
    gap: 1.5rem;
    align-items: flex-start;
    border: 3px solid var(--green);
  }

  .grid-item.hidden { display: none; }

  .empty-state {
    text-align: center;
    padding: 4rem 0;
    color: var(--ink-soft);
    font-style: italic;
    font-family: var(--font-serif);
  }

  @media (max-width: 700px) {
    .grid { grid-template-columns: 1fr; }
    .grid-item--featured .card { flex-direction: column; }
    .filter-group { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  const state: Record<string, string> = { cuisine: 'all', suburb: 'all', price: 'all' };

  function applyFilters() {
    const items = document.querySelectorAll<HTMLElement>('.grid-item');
    let visible = 0;
    items.forEach(item => {
      const match =
        (state.cuisine === 'all' || item.dataset.cuisine === state.cuisine) &&
        (state.suburb  === 'all' || item.dataset.suburb  === state.suburb)  &&
        (state.price   === 'all' || item.dataset.price   === state.price);
      item.classList.toggle('hidden', !match);
      if (match) visible++;
    });
    const c = document.getElementById('results-count');
    if (c) c.textContent = `${visible} restaurant${visible !== 1 ? 's' : ''}`;
    const e = document.getElementById('empty-state');
    if (e) e.style.display = visible === 0 ? 'block' : 'none';
  }

  document.querySelectorAll('.pill').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      const filter = el.dataset.filter!;
      state[filter] = el.dataset.value!;
      document.querySelectorAll(`[data-filter="${filter}"]`).forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      applyFilters();
    });
  });

  document.getElementById('sort-select')?.addEventListener('change', e => {
    const val = (e.target as HTMLSelectElement).value;
    const grid = document.getElementById('grid')!;
    const items = [...grid.querySelectorAll<HTMLElement>('.grid-item')];
    items.sort((a, b) => {
      if (val === 'rating') return Number(b.dataset.rating) - Number(a.dataset.rating);
      if (val === 'recent') return new Date(b.dataset.visited!).getTime() - new Date(a.dataset.visited!).getTime();
      if (val === 'name')   return a.dataset.name!.localeCompare(b.dataset.name!);
      return 0;
    });
    items.forEach(item => grid.appendChild(item));
  });
</script>
