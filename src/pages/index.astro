---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import RestaurantCard from '../components/RestaurantCard.astro';

const restaurants = await getCollection('restaurants');
const sorted = restaurants.sort((a, b) => b.data.rating - a.data.rating);

const rendered = await Promise.all(
  sorted.map(async (r) => {
    const { Content } = await render(r);
    return { data: r.data, Content };
  })
);
---

<Base title="Halal TakeOut Tasmania - Home" currentPage="home">

  <p class="siteMotto">
    Please note: All restaurants verified through word of mouth, reviews, and halal certificates
    where possible. Please use your own judgement and ask the restaurants beforehand to confirm
    beyond a shadow of doubt. If any restaurant wants to refute the claims of selling halal food,
    or if anyone wants to nominate a halal option, please reach out at
    <a href="mailto:email@example.com">email@example.com</a>
  </p>
  <pre>
A personal blog/list of all the halal restaurants around Hobart, Tasmania and occasionally elsewhere.
All ratings and reviews are purely personal opinions after trying them out for myself. They do not reflect an
objective view on the restaurants and should be taken as an opinion and not fact.
</pre>
  <section id="pastStories">
    {rendered.map(({ data, Content }) => (
      <article class="storyCard">
        <h3 class="storyTitle">{data.name}</h3>
        <div class="storySubheading">{data.suburb} &mdash; {data.cuisine}</div>

        <div class="storyMeta">
          <span class={`halalBadge ${
            data.halal_status === 'Certified'             ? 'certified'  :
            data.halal_status === 'Verified by community' ? 'community'  :
            data.halal_status === 'Owner confirmed'       ? 'owner'      :
            'unverified'
          }`}>{data.halal_status}</span>
        </div>

        <div class="storyMeta">
          <span class="ratingDisplay">
            {data.rating}/10 &mdash; {
              data.rating >= 8 ? '★ Highly recommended' :
              data.rating >= 6 ? '★ Worth a visit' :
              '★ Mixed feelings'
            }
          </span>
        </div>

        <div class="keywords">
          <span>{data.cuisine}</span>
          <span>{data.suburb}</span>
        </div>

        <button class="storyButton">Read Review</button>

        <div class="storyContent">
          <Content />
        </div>
      </article>
    ))}
  </section>

</Base>