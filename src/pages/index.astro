---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import RestaurantCard from '../components/RestaurantCard.astro';

const restaurants = await getCollection('restaurants');
const sorted = restaurants.sort((a, b) => b.data.rating - a.data.rating);

const cuisines = [...new Set(sorted.map(r => r.data.cuisine))].sort();
const suburbs  = [...new Set(sorted.map(r => r.data.suburb))].sort();
const prices   = ['$', '$$', '$$$', '$$$$'];
---

<Base title="Halal Takeout Tasmania — Halal Restaurants in Tasmania">

  <div class="page-header">
    <p class="eyebrow">Tasmania &bull; {sorted.length} Listings</p>
    <h1 class="site-motto">YOUR GUIDE TO HALAL FOOD IN TASMANIA</h1>
  </div>

  <div id="filters">
    <div class="filter-group">
      <span class="filter-label">Cuisine</span>
      <div class="filter-pills">
        <button class="pill active" data-filter="cuisine" data-value="all">All</button>
        {cuisines.map(c => <button class="pill" data-filter="cuisine" data-value={c}>{c}</button>)}
      </div>
    </div>
    <div class="filter-group">
      <span class="filter-label">Location</span>
      <div class="filter-pills">
        <button class="pill active" data-filter="suburb" data-value="all">All</button>
        {suburbs.map(s => <button class="pill" data-filter="suburb" data-value={s}>{s}</button>)}
      </div>
    </div>
    <div class="filter-group">
      <span class="filter-label">Price</span>
      <div class="filter-pills">
        <button class="pill active" data-filter="price" data-value="all">All</button>
        {prices.map(p => <button class="pill" data-filter="price" data-value={p}>{p}</button>)}
      </div>
    </div>
  </div>

  <div class="sort-bar">
    <span id="results-count" class="results-count">{sorted.length} restaurants</span>
    <select id="sort-select" class="sort-select">
      <option value="rating">Sort: Rating</option>
      <option value="recent">Sort: Most Recent</option>
      <option value="name">Sort: A–Z</option>
    </select>
  </div>

 <div id="stories">
  {sorted.map((r, i) => (
    <div
      class={`entries${i === 0 ? ' firstStory' : ''}`}
      data-cuisine={r.data.cuisine}
      data-suburb={r.data.suburb}
      data-price={r.data.price}
      data-rating={r.data.rating}
      data-visited={r.data.visited.toISOString()}
      data-name={r.data.name}
    >
      <RestaurantCard
        name={r.data.name}
        suburb={r.data.suburb}
        cuisine={r.data.cuisine}
        rating={r.data.rating}
        price={r.data.price}
        highlight={r.data.highlight}
        tags={r.data.tags}
        slug={r.slug}
        would_return={r.data.would_return}
      />
    </div>
  ))}
</div>

  <p class="empty-state" id="empty-state" style="display:none">No restaurants match those filters yet.</p>

</Base>

<style>
  .page-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--border);
  }

  .eyebrow {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--grey-mid);
    margin-bottom: 0.4rem;
  }

  .site-motto {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    letter-spacing: 0.06em;
    line-height: 1.1;
    color: var(--black);
    text-align: center;
    text-transform: uppercase;
    text-shadow: 1px 2px rgba(0,0,0,0.15);
  }

  #filters {
    background: var(--white);
    border-radius: 5px;
    border: 1px solid var(--border);
    box-shadow: var(--card-shadow);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--grey-mid);
    min-width: 4.5rem;
  }

  .filter-pills { display: flex; gap: 0.35rem; flex-wrap: wrap; }

  .pill {
    background: transparent;
    border: 1px solid var(--grey-light);
    border-radius: 4px;
    padding: 0.25rem 0.65rem;
    font-size: 0.73rem;
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    color: var(--grey-dark);
    transition: all 0.15s;
  }

  .pill:hover { border-color: var(--black); color: var(--black); }
  .pill.active { background: var(--black); border-color: var(--black); color: var(--white); }

  .sort-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .results-count {
    font-size: 0.78rem;
    color: var(--grey-mid);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .sort-select {
    font-family: var(--font-body);
    font-size: 0.78rem;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.35rem 0.7rem;
    color: var(--black);
    cursor: pointer;
  }

  /* Grid — matches your sports site #stories */
  #stories {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 20px;
  }

  /* Card wrapper — matches your .entries */
  .entries {
    background-color: var(--white);
    display: flex;
    flex-direction: column;
    row-gap: 5px;
    box-shadow: var(--card-shadow);
    border-radius: 15px;
    padding: 15px;
    max-width: 100%;
    border: 1px solid var(--border);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .entries:hover {
    transform: translateY(-3px);
    box-shadow: 7px 9px 0px rgba(0,0,0,0.18);
  }

  /* Featured first card — matches your #firstStory */
  .firstStory {
    grid-column: 1 / -1;
    flex-direction: row;
    border: 3px solid var(--black);
    padding: 20px;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .entries.hidden { display: none; }

  .empty-state {
    text-align: center;
    padding: 4rem 0;
    color: var(--grey-mid);
    font-style: italic;
    font-family: var(--font-serif);
  }

  @media (max-width: 700px) {
    #stories { grid-template-columns: 1fr; }
    .firstStory { flex-direction: column; }
    .filter-group { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  const state: Record<string, string> = { cuisine: 'all', suburb: 'all', price: 'all' };

  function applyFilters() {
    const items = document.querySelectorAll<HTMLElement>('.entries');
    let visible = 0;
    items.forEach(item => {
      const match =
        (state.cuisine === 'all' || item.dataset.cuisine === state.cuisine) &&
        (state.suburb  === 'all' || item.dataset.suburb  === state.suburb)  &&
        (state.price   === 'all' || item.dataset.price   === state.price);
      item.classList.toggle('hidden', !match);
      if (match) visible++;
    });
    const c = document.getElementById('results-count');
    if (c) c.textContent = `${visible} restaurant${visible !== 1 ? 's' : ''}`;
    const e = document.getElementById('empty-state');
    if (e) e.style.display = visible === 0 ? 'block' : 'none';
  }

  document.querySelectorAll('.pill').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      const filter = el.dataset.filter!;
      state[filter] = el.dataset.value!;
      document.querySelectorAll(`[data-filter="${filter}"]`).forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      applyFilters();
    });
  });

  document.getElementById('sort-select')?.addEventListener('change', e => {
    const val = (e.target as HTMLSelectElement).value;
    const grid = document.getElementById('stories')!;
    const items = [...grid.querySelectorAll<HTMLElement>('.entries')];
    items.sort((a, b) => {
      if (val === 'rating') return Number(b.dataset.rating) - Number(a.dataset.rating);
      if (val === 'recent') return new Date(b.dataset.visited!).getTime() - new Date(a.dataset.visited!).getTime();
      if (val === 'name')   return a.dataset.name!.localeCompare(b.dataset.name!);
      return 0;
    });
    items.forEach(item => grid.appendChild(item));
  });
</script>