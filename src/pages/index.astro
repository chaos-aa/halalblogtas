---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const restaurants = await getCollection('restaurants');
const sorted = restaurants.sort((a, b) => b.data.rating - a.data.rating);

const cuisines = [...new Set(sorted.map(r => r.data.cuisine))].sort();
const suburbs  = [...new Set(sorted.map(r => r.data.suburb))].sort();
const prices   = ['$', '$$', '$$$', '$$$$'];
---

<Base title="Halal Takeout Tasmania — Halal Restaurants in Tasmania">

  <div class="page-header">
    <p class="eyebrow">Tasmania &bull; {sorted.length} Listings</p>
    <h1 class="site-motto">YOUR GUIDE TO HALAL FOOD IN TASMANIA</h1>
  </div>

  <div id="filters">
    <div class="filter-group">
      <span class="filter-label">Cuisine</span>
      <div class="filter-pills">
        <button class="pill active" data-filter="cuisine" data-value="all">All</button>
        {cuisines.map(c => <button class="pill" data-filter="cuisine" data-value={c}>{c}</button>)}
      </div>
    </div>
    <div class="filter-group">
      <span class="filter-label">Location</span>
      <div class="filter-pills">
        <button class="pill active" data-filter="suburb" data-value="all">All</button>
        {suburbs.map(s => <button class="pill" data-filter="suburb" data-value={s}>{s}</button>)}
      </div>
    </div>
    <div class="filter-group">
      <span class="filter-label">Price</span>
      <div class="filter-pills">
        <button class="pill active" data-filter="price" data-value="all">All</button>
        {prices.map(p => <button class="pill" data-filter="price" data-value={p}>{p}</button>)}
      </div>
    </div>
  </div>

  <div class="sort-bar">
    <span id="results-count" class="results-count">{sorted.length} restaurants</span>
    <select id="sort-select" class="sort-select">
      <option value="rating">Sort: Rating</option>
      <option value="recent">Sort: Most Recent</option>
      <option value="name">Sort: A–Z</option>
    </select>
  </div>

  <div id="stories">
    {sorted.map((r, i) => {
      const d = r.data;
      const ratingClass = d.rating >= 8 ? 'high' : d.rating >= 6 ? 'mid' : 'low';
      return (
        <article
          class={`entries${i === 0 ? ' firstStory' : ''}`}
          data-cuisine={d.cuisine}
          data-suburb={d.suburb}
          data-price={d.price}
          data-rating={d.rating}
          data-visited={d.visited.toISOString()}
          data-name={d.name}
        >
          <a href={`/restaurants/${r.slug}`} class="card-link">

            <div class="card-top">
              <div class="card-labels">
                <span class="cuisine-tag">{d.cuisine}</span>
                <span class="price-tag">{d.price}</span>
              </div>
              <div class={`rating rating--${ratingClass}`}>
                <span class="rating-num">{d.rating}</span>
                <span class="rating-denom">/10</span>
              </div>
            </div>

            <h2>{d.name}</h2>
            <p class="suburb">📍 {d.suburb}</p>
            <p class="subheading">{d.highlight}</p>

            <div class="keywords">
              {d.tags.slice(0, 4).map(tag => (
                <span class="tag">{tag}</span>
              ))}
              {d.would_return && <span class="tag return-tag">↩ Return</span>}
            </div>

          </a>
        </article>
      );
    })}
  </div>

  <p class="empty-state" id="empty-state" style="display:none">No restaurants match those filters yet.</p>

</Base>


<script>
  const state: Record<string, string> = { cuisine: 'all', suburb: 'all', price: 'all' };

  function applyFilters() {
    const items = document.querySelectorAll<HTMLElement>('.entries');
    let visible = 0;
    items.forEach(item => {
      const match =
        (state.cuisine === 'all' || item.dataset.cuisine === state.cuisine) &&
        (state.suburb  === 'all' || item.dataset.suburb  === state.suburb)  &&
        (state.price   === 'all' || item.dataset.price   === state.price);
      item.classList.toggle('hidden', !match);
      if (match) visible++;
    });
    const c = document.getElementById('results-count');
    if (c) c.textContent = `${visible} restaurant${visible !== 1 ? 's' : ''}`;
    const e = document.getElementById('empty-state');
    if (e) e.style.display = visible === 0 ? 'block' : 'none';
  }

  document.querySelectorAll('.pill').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      const filter = el.dataset.filter!;
      state[filter] = el.dataset.value!;
      document.querySelectorAll(`[data-filter="${filter}"]`).forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      applyFilters();
    });
  });

  document.getElementById('sort-select')?.addEventListener('change', e => {
    const val = (e.target as HTMLSelectElement).value;
    const grid = document.getElementById('stories')!;
    const items = [...grid.querySelectorAll<HTMLElement>('.entries')];
    items.sort((a, b) => {
      if (val === 'rating') return Number(b.dataset.rating) - Number(a.dataset.rating);
      if (val === 'recent') return new Date(b.dataset.visited!).getTime() - new Date(a.dataset.visited!).getTime();
      if (val === 'name')   return a.dataset.name!.localeCompare(b.dataset.name!);
      return 0;
    });
    items.forEach(item => grid.appendChild(item));
  });
</script>