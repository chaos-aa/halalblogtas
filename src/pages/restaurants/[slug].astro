---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const restaurants = await getCollection('restaurants');
  return restaurants.map(r => ({
    params: { slug: r.slug },
    props: { restaurant: r },
  }));
}

const { restaurant } = Astro.props;
const { Content } = await restaurant.render();
const d = restaurant.data;

const dateFormatted = d.visited.toLocaleDateString('en-AU', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<Base title={`${d.name} — Halal Takeout Tasmania`} description={d.highlight}>
  <div class="back-link">
    <a href="/">← All Restaurants</a>
  </div>

  <article>
    <header class="review-header">
      <div class="header-top">
        <div class="header-tags">
          <span class="cuisine-tag">{d.cuisine}</span>
          <span class="price-tag">{d.price}</span>
          {d.would_return && <span class="return-tag">↩ Would Return</span>}
        </div>
        <div class="rating">
          <span class="rating-num">{d.rating}</span>
          <span class="rating-denom">/10</span>
        </div>
      </div>

      <h1 class="restaurant-name">{d.name}</h1>

      <div class="meta-row">
        <span>📍 {d.suburb}{d.address ? ` — ${d.address}` : ''}</span>
        <span>🗓 {dateFormatted}</span>
      </div>

      <blockquote class="highlight-quote">"{d.highlight}"</blockquote>

      {d.recommended_dishes && d.recommended_dishes.length > 0 && (
        <div class="dishes">
          <span class="dishes-label">Must order</span>
          <div class="dishes-list">
            {d.recommended_dishes.map(dish => <span class="dish">{dish}</span>)}
          </div>
        </div>
      )}

      <div class="tags-row">
        {d.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    </header>

    <div class="review-body prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back-link { margin-bottom: 1.5rem; }

  .back-link a {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--grey-mid);
    transition: color 0.15s;
  }

  .back-link a:hover { color: var(--black); }

  article { max-width: 740px; }

  .review-header {
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--border);
    margin-bottom: 2rem;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.6rem;
  }

  .header-tags { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }

  .cuisine-tag {
    background-color: var(--black);
    color: #ccc;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 4px;
    padding: 0.25rem 0.6rem;
  }

  .price-tag {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--grey-dark);
    background: var(--cream-dark);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
  }

  .return-tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--grey-dark);
    border: 1px solid var(--grey-light);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
  }

  .rating {
    display: flex;
    align-items: baseline;
    gap: 2px;
    line-height: 1;
  }

  .rating-num {
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 1;
    color: var(--black);
  }

  .rating-denom { font-size: 1rem; color: var(--grey-mid); }

  .restaurant-name {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7vw, 5rem);
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--black);
    margin-bottom: 0.75rem;
    text-shadow: 2px 2px 0 rgba(0,0,0,0.08);
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 0.8rem;
    color: var(--grey-mid);
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
  }

  .highlight-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--grey-dark);
    border-left: 4px solid var(--black);
    padding-left: 1rem;
    margin: 0 0 1.25rem;
    line-height: 1.6;
  }

  .dishes {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .dishes-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--grey-mid);
  }

  .dishes-list { display: flex; gap: 0.4rem; flex-wrap: wrap; }

  .dish {
    background: var(--black);
    color: #ccc;
    font-size: 0.76rem;
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .tags-row { display: flex; gap: 0.35rem; flex-wrap: wrap; }

  .tag {
    display: inline-block;
    background-color: var(--cream-dark);
    color: var(--grey-dark);
    font-size: 0.68rem;
    font-weight: 500;
    border-radius: 4px;
    border: 1px solid var(--border);
    padding: 0.2rem 0.55rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .prose {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.85;
    color: var(--black);
  }

  .prose :global(p) { margin-bottom: 1.2rem; }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(em) { font-style: italic; }
  .prose :global(h2), .prose :global(h3) {
    font-family: var(--font-display);
    letter-spacing: 0.04em;
    margin: 1.8rem 0 0.6rem;
  }
</style>