---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Honest restaurant reviews. No ads, no comps." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --green:        #2e6f40;
      --green-light:  #4e8f60;
      --green-dark:   #1a4a28;
      --cream:        #f8f5f0;
      --white:        #ffffff;
      --ink:          #1a1a1a;
      --ink-mid:      #444;
      --ink-soft:     #777;
      --border:       #ddd;
      --card-shadow:  5px 5px 0px rgba(46,111,64,0.18);
      --font-display: 'Bebas Neue', 'Franklin Gothic Medium', Arial, sans-serif;
      --font-serif:   'Lora', Georgia, serif;
      --font-body:    'DM Sans', Helvetica, sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background-color: var(--cream);
      color: var(--ink);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.7;
      display: flex;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
    }

    #site-wrapper {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 980px;
      padding: 0 1rem 2rem;
    }

    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }

    /* ── HEADER ── */
    .site-header {
      padding: 1.5rem 0 0;
      border-bottom: 3px solid var(--ink);
      margin-bottom: 0;
    }

    .site-header-inner {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      padding-bottom: 0.75rem;
    }

    .site-logo {
      font-family: var(--font-display);
      font-size: clamp(2.8rem, 6vw, 4.5rem);
      letter-spacing: 0.04em;
      line-height: 1;
      color: var(--ink);
    }

    .site-logo span {
      color: var(--green);
    }

    .site-tagline {
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-soft);
      padding-bottom: 0.4rem;
    }

    /* ── NAV ── */
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background-color: var(--green);
    }

    .site-nav ul {
      list-style: none;
      display: flex;
      align-items: center;
      gap: 0;
      padding: 0 0.5rem;
      margin: 0;
    }

    .site-nav a {
      display: inline-block;
      color: #d4edda;
      text-transform: uppercase;
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      padding: 0.6rem 0.9rem;
      white-space: nowrap;
      transition: background 0.15s, color 0.15s;
    }

    .site-nav a:hover,
    .site-nav a.active {
      background-color: var(--green-dark);
      color: #fff;
    }

    /* ── MAIN ── */
    main {
      margin-top: 2rem;
      margin-bottom: 2rem;
      flex: 1;
    }

    /* ── FOOTER ── */
    footer {
      border-top: 2px solid var(--border);
      padding: 1.25rem 0;
      text-align: center;
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-soft);
      margin-top: auto;
    }

    /* ── SCROLL TO TOP ── */
    #topBtn {
      display: flex;
      position: fixed;
      right: 1.25rem;
      bottom: 1.25rem;
      width: 2.75rem;
      height: 2.75rem;
      background-color: var(--green);
      border-radius: 6px;
      color: #d4edda;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      text-decoration: none;
      opacity: 0.7;
      transition: opacity 0.2s, background 0.2s;
      z-index: 200;
    }

    #topBtn:hover { opacity: 1; background-color: var(--green-dark); }

    @media (max-width: 600px) {
      .site-header-inner { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
      .site-tagline { padding-bottom: 0; }
    }
  </style>
</head>
<body>
  <div id="site-wrapper">

    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="site-logo">FORK<span>&</span>FOUND</a>
        <span class="site-tagline">Honest reviews &bull; Melbourne</span>
      </div>
      <nav class="site-nav">
        <ul>
          <li><a href="/" id="nav-home">All Reviews</a></li>
          <li><a href="/about" id="nav-about">About</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <a href="#" id="topBtn" title="Scroll to top">↑</a>

    <footer>
      <p>Fork &amp; Found &mdash; Personal opinions. No ads. No sponsored content.</p>
    </footer>

  </div>

  <script>
    // Highlight current nav link
    const path = window.location.pathname;
    if (path === '/' || path.startsWith('/restaurants')) {
      document.getElementById('nav-home')?.classList.add('active');
    } else if (path.startsWith('/about')) {
      document.getElementById('nav-about')?.classList.add('active');
    }
  </script>
</body>
</html>
