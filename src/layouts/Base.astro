---
interface Props {
  title: string;
  currentPage?: string;
}
const { title, currentPage = 'home' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="author" content="Taif Al-Amin">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href={`${import.meta.env.BASE_URL}/styles/style.css`}>
  <title>{title}</title>
</head>

<body>
  <div id="container">

    <header>
      <img src="" alt="Site Logo">
    </header>

    <nav>
      <ul id="navBar">
        <li id={currentPage === 'home' ? 'currentItem' : undefined}>
          {currentPage === 'home' ? 'Home' : <a href="/">Home</a>}
        </li>
        <li id={currentPage === 'about' ? 'currentItem' : undefined}>
          {currentPage === 'about' ? 'About Us' : <a href="/about">About Us</a>}
        </li>
      </ul>
    </nav>

    <main>
      <slot />
    </main>

    <a href="#" id="topBtn">Scroll To Top</a>

    <footer>
      © Taif Al-Amin, all respective restaurant information taken from publicly available information,
      and belongs to the respective restaurants and organisations.
    </footer>

  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const storyButtons = document.querySelectorAll(".storyButton");
      storyButtons.forEach(function (button) {
        button.addEventListener("click", function () {
          const storyContent = button.nextElementSibling;
          storyContent.classList.toggle("show");
          if (storyContent.classList.contains("show")) {
            button.textContent = "Hide Story";
          } else {
            button.textContent = "Read More";
          }
        });
      });
    });
  </script>
</body>
</html>
